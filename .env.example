# Copy to .env and fill in. .env is gitignored — never commit it.

# Inference
VLM_BACKEND=gemini            # ollama | gemini
VLM_MODEL=gemini-3.6-flash    # pin an exact version, never a -latest alias
GEMINI_API_KEY=               # https://aistudio.google.com/apikey
VLM_MODEL_PATH=               # local weights, ollama backend only
VLM_QUANTIZATION=4bit         # 4bit | 8bit | none — CUDA only
FILTER_YOLO_CONF=0.15
FILTER_CLIP_THRESHOLD=0.23    # calibrate via benchmark

# Storage
R2_ENDPOINT=
R2_KEY=
R2_SECRET=
R2_BUCKET=stills
R2_PUBLIC_DOMAIN=             # e.g. cdn.yourdomain.com

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pipeline
SAMPLE_RATE_FPS=1.0
BATCH_SIZE_FILTER=32
BATCH_SIZE_VLM=8
RECONCILER_WINDOW_SECONDS=120
