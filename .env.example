# Copy to .env and fill in. .env is gitignored — never commit it.

# Inference
VLM_MODEL_PATH=               # local path to model weights
VLM_QUANTIZATION=4bit         # 4bit | 8bit | none
FILTER_YOLO_CONF=0.15
FILTER_CLIP_THRESHOLD=0.23    # calibrate via benchmark

# Storage
R2_ENDPOINT=
R2_KEY=
R2_SECRET=
R2_BUCKET=stills
R2_PUBLIC_DOMAIN=             # e.g. cdn.yourdomain.com

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pipeline
SAMPLE_RATE_FPS=1.0
BATCH_SIZE_FILTER=32
BATCH_SIZE_VLM=8
RECONCILER_WINDOW_SECONDS=120
