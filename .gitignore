# Secrets
.env

# Spec — kept local
PROJECT.md

# Local agent config
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Supabase CLI local state
supabase/.temp/

# Model weights and extracted frames — large and regenerable
frames/
models/
*.pt
*.gguf
*.safetensors

# Pipeline outputs — regenerable from the frames
vlm_results.jsonl
srt_results.json
candidates.json

# Benchmark frames are large. labels.json and benchmark/results/ are hand-made
# and irreplaceable, so they are deliberately NOT ignored.
# Leading **/ matters: a pattern containing a slash is anchored to the repo
# root, which would miss pipeline/benchmark/labelled/ entirely.
**/benchmark/labelled/**/*.jpg
**/benchmark/labelled/**/*.png

# Synthetic clock faces are regenerated deterministically by make_clock_set.py.
**/benchmark/clock_set/
